# Everything here is optional: you can enter the device address and API key in the app's Settings
# instead (they're saved in data/config.json, which takes precedence over these).
# TIINY_URL=http://192.168.1.50
# TIINY_KEY=your-device-api-key

# Network access. Private by default: only this computer can open the studio.
# Set to 0.0.0.0 to let phones and other computers on your network use it (then also set a password).
# STUDIO_BIND=0.0.0.0

# Require a password in the browser (any username). Strongly recommended with STUDIO_BIND=0.0.0.0.
# STUDIO_PASSWORD=choose-something
