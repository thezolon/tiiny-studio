{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiiny Studio",
  "version": "0.7.2",
  "identifier": "io.github.thezolon.tiinystudio",
  "build": {},
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "rpm", "appimage"],
    "publisher": "Zolon Farsane",
    "copyright": "Apache-2.0",
    "category": "Utility",
    "shortDescription": "Local media studio for the Tiiny Pocket",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": { "bundleMediaFramework": true },
      "deb": { "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"] },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3", "gstreamer1-plugins-base", "gstreamer1-plugins-good"],
        "recommends": ["gstreamer1-plugins-bad-free", "gstreamer1-plugin-libav"]
      }
    }
  }
}
